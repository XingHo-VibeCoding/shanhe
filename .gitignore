# 敏感文件 —— 绝不提交到 GitHub
.env
.env.*
*.local

# 标题索引与抓取进度（派生产物，由抓取脚本生成，不提交）
my-app/title_index.json
my-app/fetch_progress.json
my-app/fetch_content_progress.json

# 本地网络调试脚本（GitHub 推送用的临时转发代理，硬编码 IP，不上传）
my-app/_ghproxy.py

# chinese-poetry 开源数据源（import_poetry.py 的原料，300MB+，不提交）
_poetry_src/

# 密码 / 密钥 / 凭证
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
*.secret

# 依赖目录
node_modules/

# Python 缓存与虚拟环境
__pycache__/
*.pyc
.venv/
venv/

# 本地数据库文件
*.db
*.sqlite
*.sqlite3

# 系统 / 编辑器杂项
.DS_Store
Thumbs.db

# 工作记忆（非项目内容，不上传）
.workbuddy/

# 本地调试产物（截图 / 探针日志 / 临时预览页，不上传 GitHub）
# 说明：my-app 根目录只放调试截图；正式图片资源都在 assets/ 与 ink-paintings/ 子目录里
my-app/*.png
my-app/design-preview-*.html
my-app/.playwright-cli/
_online.html
_oni.json
.wbapp_*.genie

# 一句一画：去水印前的原图备份（本地留档，不入库）
my-app/ink-paintings/_originals/
